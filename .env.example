# === ОКРУЖЕНИЕ ===
# development — локальная разработка (Mailpit, без TLS, ослабленные проверки)
# production  — продакшен (полноценный SMTP, все секреты обязательны)
ENVIRONMENT=development

# Название приложения (отображается в теме письма, шаблонах и т.д.)
APP_NAME=МояПлатформа

# === БАЗА ДАННЫХ ===
# Хост PostgreSQL (в Docker — имя контейнера `database`, локально — `localhost`)
DATABASE_HOST=database

# Никнейм пользователя в БД (можно оставить пустым для дефолта `postgres`)
POSTGRES_USER=

# Пароль доступа к БД (ОБЯЗАТЕЛЬНО: минимум 12 символов)
POSTGRES_PASSWORD=

# Название БД (Дефолт `db`)
POSTGRES_DB=

# === Redis ===
# Хост Redis (используется имя контейнера из docker-compose.yml)
REDIS_HOST=redis

# Порт, на котором работает Redis (нужен для docker-compose.yml)
REDIS_PORT=6379

# Пароль для Redis (ОБЯЗАТЕЛЬНО: минимум 12 символов)
REDIS_PASSWORD=

# === Безопасность API ===
# Секрет для Livekit-webhook (чтобы проверять, что ответ пришел от сервера Livekit)
# Генерируется скриптом generate_env.sh в корне проекта
WEBHOOK_SECRET=

# Секрет для проверки сигнатуры JWT-токена
# Может генерироваться скриптом generate_env.sh в корне проекта
# Запуск на Linux - ./generate_env.sh
# Запуск на Windows в терминале невозможен - нужна среда, понимающая Bash (Обычно, это Git bash)
JWT_SECRET_KEY=

# Алгоритм подписи JWT-токена
JWT_ALGORITHM=

# Время жизни access JWT-токена (Дефолт 30 минут)
ACCESS_JWT_TOKEN_EXPIRES_IN_MINUTES=

# Время жизни refresh JWT-токена (Дефолт 7 дней)
REFRESH_JWT_TOKEN_EXPIRES_IN_DAYS=

# === SMTP (почта) ===
# В development-режиме можно оставить пустыми — используется Mailpit (localhost:1025)
# В production-режиме ОБЯЗАТЕЛЬНО заполнить все поля

# SMTP-хост (дефолт smtp.yandex.ru)
SMTP_HOST=

# SMTP-порт (дефолт 465)
SMTP_PORT=

# Адрес отправителя писем
SMTP_FROM_EMAIL=

# Пароль SMTP (в production — обязателен)
SMTP_PASSWORD=
