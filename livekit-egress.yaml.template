# LiveKit Egress конфигурация (шаблон)
# Реальные значения подставляются через generate_env.py

api_port: 7881
api_key: LIVEKIT_API_KEY_PLACEHOLDER
api_secret: LIVEKIT_API_SECRET_PLACEHOLDER
ws_url: ws://livekit:7880

s3:
  access_key: S3_ACCESS_KEY_PLACEHOLDER
  secret: S3_SECRET_KEY_PLACEHOLDER
  bucket: S3_BUCKET_PLACEHOLDER
  region: S3_REGION_PLACEHOLDER
  endpoint: S3_ENDPOINT_PLACEHOLDER

redis:
  address: redis:6379
  password: REDIS_PASSWORD_PLACEHOLDER
